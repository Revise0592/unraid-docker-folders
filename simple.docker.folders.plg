<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "simple.docker.folders">
<!ENTITY author    "Revise0592">
<!ENTITY version   "2026.11.10c">
<!ENTITY md5       "01c739b09b9979582215010d7e159e9f">
<!ENTITY launch    "Docker">
<!ENTITY gitURL    "https://raw.githubusercontent.com/&author;/unraid-docker-folders/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
<!ENTITY pkg       "&name;-&version;-noarch-1">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" icon="folder-docker.png" support="https://github.com/&author;/unraid-docker-folders/issues">

<CHANGES>
###2026.11.10c
- Fixed formatting bug on dashboard page

###2026.11.10b
- Added dashboard folder functionality.

###2026.11.10a
- Added an app icon

###2026.11.10
- Initial release: group containers into collapsible folders, optional custom folder image, start/stop/restart a whole folder.
</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&pkg;.txz" Run="upgradepkg --install-new">
<URL>https://github.com/&author;/unraid-docker-folders/releases/download/&version;/&pkg;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name;/icons
# drop packages from previous versions
find /boot/config/plugins/&name; -maxdepth 1 -name '&name;-*.txz' ! -name '&pkg;.txz' -delete
echo "&name; &version; installed"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &pkg;
rm -rf /usr/local/emhttp/plugins/&name;
rm -f /boot/config/plugins/&name;/*.txz
echo "&name; removed. Folder definitions are kept in /boot/config/plugins/&name;/ (delete that directory to remove them)."
</INLINE>
</FILE>

</PLUGIN>
